# Telegram Bot Configuration
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Application Settings
PDF_STORAGE_PATH=/app/rules_pdfs
DATA_PATH=/app/data
LOG_LEVEL=INFO
# LOG_FORMAT: "text" for local dev (human-readable), "json" for production (Loki/Datadog)
LOG_FORMAT=text

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=10
MAX_CONCURRENT_SEARCHES=4

# Admin Access (comma-separated list of Telegram user IDs)
ADMIN_USER_IDS=123456789

# Per-user budget (BUDGET_ENABLED=false disables check + record entirely)
BUDGET_ENABLED=true
DAILY_REQUEST_LIMIT=50
DAILY_TOKEN_LIMIT=300000
MONTHLY_REQUEST_LIMIT=1000
MONTHLY_TOKEN_LIMIT=6000000

# Session history retention
SESSION_MAX_TURNS=20
SESSION_TTL_DAYS=30
RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# Langfuse Observability (Optional - leave empty to disable)
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ENABLE_TRACING=false
LANGFUSE_ENVIRONMENT=production

# Health & Heartbeat
# HEALTH_PORT=0 disables the HTTP endpoint; HEARTBEAT_INTERVAL_SECONDS=0 disables the periodic log
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
HEARTBEAT_INTERVAL_SECONDS=300

# Sentry Error Tracking (Optional - leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Sentry's own APM tracing — keep 0.0 since we already use OpenTelemetry → Langfuse
SENTRY_TRACES_SAMPLE_RATE=0.0

# BoardGameGeek API (Optional - required for automatic game metadata)
# Register at https://boardgamegeek.com/applications
BGG_API_TOKEN=
